# ============================================
# Haqwa .gitignore
# ============================================

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
# Google Cloud service account keys / ADC files
*service-account*.json
*credentials*.json
application_default_credentials.json
client_secret*.json
.gcloud/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.python-version

# --- Testing / type checking / linting ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyright/

# --- Frontend (web/frontend) ---
node_modules/
web/frontend/dist/
web/frontend/build/
web/frontend/.vite/
web/frontend/.next/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Google ADK / local agent runs ---
.adk/

# --- Local runtime output ---
*.log
logs/
tmp/
.cache/
# Local Gemini response cache (commit curated demo cache under demo/ explicitly if needed)
.haqwa_cache/

# --- Editors / IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Claude Code local settings ---
.claude/settings.local.json


test1.md